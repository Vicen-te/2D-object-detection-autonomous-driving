# Python virtual environment
.venv/

# Dataset directories
dataset/

# YOLO outputs: training runs, predictions, and video tracking
runs/
training_results/*
# ...but keep the lightweight, reviewable artefacts of the published run
# (metrics, curves, config, sample predictions). Weights, TF events and
# the raw predictions.json stay out of the repo.
!training_results/finetuning/
training_results/finetuning/*
!training_results/finetuning/results.csv
!training_results/finetuning/results.png
!training_results/finetuning/args.yaml
!training_results/finetuning/confusion_matrix_normalized.png
!training_results/finetuning/PR_curve.png
!training_results/finetuning/F1_curve.png
!training_results/finetuning/val_batch0_pred.jpg
!training_results/finetuning/val_batch0_labels.jpg

# Video files
videos/

# Automatic download of YOLO11n just to perform AMP (Automatic Mixed Precision) checks
*.pt

# Python cache
__pycache__

# MLflow tracking directory
mlflow!training_results/regime_comparison/
training_results/regime_comparison/*
!training_results/regime_comparison/summary.csv
!training_results/regime_comparison/*/
training_results/regime_comparison/*/*
!training_results/regime_comparison/*/results.csv
!training_results/regime_comparison/*/results.png
!training_results/regime_comparison/*/args.yaml
regime_comparison.log
regime_comparison.err
